# AnalyzeIt Parser / Agent service — env template. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; this template is committed.

# OpenRouter reasoning provider (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model is configuration, not code (PRD v3 §11.1). Swapping the model must never
# require a code change. NOTE: stealth/ox-alpha graduated and now 404s — its
# production id is z-ai/glm-5.3-flash.
MODEL_PRIMARY=z-ai/glm-5.3-flash
MODEL_SECONDARY=z-ai/glm-5.3-flash

# Shared secret the Next.js dashboard bridge presents as `Authorization: Bearer`.
# MUST match HERMES_API_SECRET in apps/web/.env.local.
HERMES_API_SECRET=

# HMAC signing key for the controlled tool layer (PRD v3 §7).
# MUST match TOOL_LAYER_SECRET in apps/web/.env.local. >= 32 chars.
TOOL_LAYER_SECRET=

# Supabase (service-role key — bypasses RLS; server-only, never in the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Bind port
PORT=8100
