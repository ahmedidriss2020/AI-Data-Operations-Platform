# Copy to .env.local and fill in. For local development, run `supabase start`
# from the repository root and use the values it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: the service-role / secret key. Bypasses RLS, so it is read only
# inside server routes and server actions, and never reaches the browser bundle.
SUPABASE_SECRET_KEY=

# --- Hermes agent bridge (PRD v3 section 11) -------------------------------
# The managed Hermes Agent on Hostinger. Server-only: these are read inside
# route handlers, never in a client component, and `lib/hermes.ts` imports
# `server-only` so a mistaken client import fails the build rather than
# shipping the secret to the browser.
HERMES_AGENT_ENDPOINT=
HERMES_API_SECRET=

# --- Reasoning provider (PRD v3 section 11.1) ------------------------------
# OpenRouter is OpenAI-compatible. The model is configuration, not code:
# swapping MODEL_PRIMARY must never require a code change.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PRIMARY=google/gemini-3.7-flash
MODEL_SECONDARY=moonshotai/kimi-k3
MODEL_BATCH=google/gemini-3.7-flash:batch

# --- Controlled tool layer (PRD v3 section 7) ------------------------------
# The secret Hermes presents when calling back into /api/tools/*. Distinct from
# HERMES_API_SECRET, which is the outbound direction: rotating one must not
# silently authorize the other. Also signs the scope tokens that carry a proven
# (org, workspace, user) into each tool call, so it must be at least 32 chars.
#   openssl rand -hex 32
TOOL_LAYER_SECRET=

# The URL Hermes should call back on. Handed to the agent per chat turn so the
# agent does not need it configured on its side.
TOOL_LAYER_PUBLIC_URL=
