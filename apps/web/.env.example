# Copy to .env.local and fill in. For local development, run `supabase start`
# from the repository root and use the values it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: the service-role / secret key. Bypasses RLS, so it is read only
# inside server routes and server actions, and never reaches the browser bundle.
SUPABASE_SECRET_KEY=
